{
 "uid": "agency-llmops",
 "title": "Agency LLMOps",
 "schemaVersion": 39,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "tags": [
  "llmops"
 ],
 "panels": [
  {
   "type": "stat",
   "title": "Spend last 24h",
   "datasource": {
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(agency_llm_cost_usd_total[24h]))",
     "refId": "A"
    }
   ],
   "gridPos": {
    "w": 6,
    "h": 4,
    "x": 0,
    "y": 0
   },
   "id": 1
  },
  {
   "type": "stat",
   "title": "Tokens last 24h",
   "datasource": {
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(agency_llm_tokens_total[24h]))",
     "refId": "A"
    }
   ],
   "gridPos": {
    "w": 6,
    "h": 4,
    "x": 6,
    "y": 0
   },
   "id": 2
  },
  {
   "type": "stat",
   "title": "Agent runs last 24h",
   "datasource": {
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(increase(agency_agent_runs_total[24h]))",
     "refId": "A"
    }
   ],
   "gridPos": {
    "w": 6,
    "h": 4,
    "x": 12,
    "y": 0
   },
   "id": 3
  },
  {
   "type": "stat",
   "title": "Response cache hit ratio (1h)",
   "datasource": {
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(agency_cache_events_total{layer=\"response\",result=\"hit\"}[1h])) / clamp_min(sum(rate(agency_cache_events_total{layer=\"response\"}[1h])),1e-9)",
     "refId": "A"
    }
   ],
   "gridPos": {
    "w": 6,
    "h": 4,
    "x": 18,
    "y": 0
   },
   "id": 4
  },
  {
   "type": "timeseries",
   "title": "Spend per topic ($/h)",
   "datasource": {
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (topic) (increase(agency_llm_cost_usd_total[1h]))",
     "legendFormat": "{{topic}}",
     "refId": "A"
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 0,
    "y": 4
   },
   "id": 5
  },
  {
   "type": "timeseries",
   "title": "Tokens per topic (/h)",
   "datasource": {
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (topic) (increase(agency_llm_tokens_total[1h]))",
     "legendFormat": "{{topic}}",
     "refId": "A"
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 12,
    "y": 4
   },
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "LLM calls by tier",
   "datasource": {
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (tier) (rate(agency_llm_calls_total[5m]))",
     "legendFormat": "{{tier}}",
     "refId": "A"
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 0,
    "y": 12
   },
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "Routing decisions by source",
   "datasource": {
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (source, tier) (rate(agency_model_routing_total[5m]))",
     "legendFormat": "{{source}} -> {{tier}}",
     "refId": "A"
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 12,
    "y": 12
   },
   "id": 8
  },
  {
   "type": "timeseries",
   "title": "LLM p95 latency by model",
   "datasource": {
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, model) (rate(agency_llm_call_seconds_bucket[5m])))",
     "legendFormat": "{{model}}",
     "refId": "A"
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 0,
    "y": 20
   },
   "id": 9
  },
  {
   "type": "timeseries",
   "title": "LLM error rate by model",
   "datasource": {
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (model) (rate(agency_llm_calls_total{status=\"error\"}[5m])) / sum by (model) (rate(agency_llm_calls_total[5m]))",
     "legendFormat": "{{model}}",
     "refId": "A"
    }
   ],
   "gridPos": {
    "w": 12,
    "h": 8,
    "x": 12,
    "y": 20
   },
   "id": 10
  },
