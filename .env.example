# Local secrets file is .env (gitignored; docker compose reads it automatically). Create it with:
#   python3 scripts/gen_secrets.py --env-file .env    # generates internal secrets, adds empty provider keys
#   python3 scripts/gen_secrets.py --check .env       # what's set / missing (values hidden)
# Staging/prod: every key below lives in Infisical, synced by the Infisical Operator.

# Backstage "Create deployment" reads this file. Tags at the start of a comment:
#   # secret  → Infisical (typed in, never in git)      # config → plain env in the deployment (git), pre-filled
#   add ", optional" when it may stay empty. No tag = secret + required.
# REDIS_URL / REDIS_KEY_PREFIX are not listed: the Redis switch provides them.

# --- databases ---
DATABASE_URL=mysql://agency-alim:<password>@<db-host>:3306/agency?ssl-mode=REQUIRED   # secret — app user: rows only (local: compose sets it)
MIGRATE_DATABASE_URL=mysql://agency-admn:<password>@<db-host>:3306/agency?ssl-mode=REQUIRED   # secret — migrations user: DDL (local: compose sets it)

# --- internal (generated: python3 scripts/gen_secrets.py [--eddsa]) ---
JWT_SECRET_KEY=                 # secret — dev only (HS256). staging/prod use JWT_PRIVATE_KEY/JWT_PUBLIC_KEY (base64 PEM)
EDGE_GATEWAY_SECRET=            # secret — per-service model-gateway client secrets (>= 32 chars)
EV_RESEARCH_GATEWAY_SECRET=
PRODUCT_FINDER_GATEWAY_SECRET=
FINANCE_GATEWAY_SECRET=
QUALITY_GATEWAY_SECRET=         # secret — quality worker (evals, online judge)
EVAL_USER_EMAIL=evals@agency.internal   # config — login name of the quality worker's service account
EVAL_USER_PASSWORD=             # secret — service account, plan 'internal' (docker compose --profile quality run --rm eval-user)

# --- providers (model-gateway only) ---
GEMINI_API_KEY=

# --- tools ---
TAVILY_API_KEY=                 # secret — web search (EV + product finder)

# --- observability ---
LANGSMITH_TRACING=false         # config — true sends traces to LangSmith (needs LANGSMITH_API_KEY)
LANGSMITH_API_KEY=              # secret, optional — tracing stays off without it (LANGSMITH_TRACING=false)
LANGSMITH_PROJECT=autonomous-agency   # config — project name in LangSmith
CORS_ALLOWED_ORIGINS=https://agency-dev.everesto.live   # config — browser origins allowed to call the API (comma-separated; same-origin needs none)

# --- alerts / monitoring ---
ALERT_WEBHOOK_URL=              # secret, optional — Slack/Teams webhook for drift alerts — leave it out of the deployment if unused
GRAFANA_ADMIN_PASSWORD=         # secret, optional — local docker compose Grafana only — not part of the deployment
