# Local secrets file is .env (gitignored; docker compose reads it automatically). Create it with:
#   python3 scripts/gen_secrets.py --env-file .env    # generates internal secrets, adds empty provider keys
#   python3 scripts/gen_secrets.py --check .env       # what's set / missing (values hidden)
# Staging/prod: every key below lives in Infisical, synced by the Infisical Operator.

# --- internal (generated: python3 scripts/gen_secrets.py [--eddsa]) ---
JWT_SECRET_KEY=                 # dev only (HS256). staging/prod use JWT_PRIVATE_KEY/JWT_PUBLIC_KEY (base64 PEM)
EDGE_GATEWAY_SECRET=            # per-service model-gateway client secrets (>= 32 chars)
EV_RESEARCH_GATEWAY_SECRET=
PRODUCT_FINDER_GATEWAY_SECRET=
FINANCE_GATEWAY_SECRET=
QUALITY_GATEWAY_SECRET=         # quality worker (evals, online judge)
EVAL_USER_EMAIL=evals@agency.internal
EVAL_USER_PASSWORD=             # service account, plan 'internal' (docker compose --profile quality run --rm eval-user)

# --- providers (model-gateway only) ---
GEMINI_API_KEY=

# --- tools ---
TAVILY_API_KEY=                 # web search (EV + product finder)

# --- observability ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=autonomous-agency
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- alerts / monitoring ---
ALERT_WEBHOOK_URL=              # Slack/Teams webhook for drift alerts (optional)
GRAFANA_ADMIN_PASSWORD=
